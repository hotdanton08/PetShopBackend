{
  "name": "myapp",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "migrate-seed:all": "sequelize db:migrate && sequelize db:seed:all && cd config && migrate-mongo up",
    "undo:migrate-seed:all": "sequelize db:seed:undo:all && sequelize db:migrate:undo:all && cd config && migrate-mongo down"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dotenv": "^16.4.5",
    "express": "~4.16.1",
    "express-validator": "^7.1.0",
    "http-errors": "~1.6.3",
    "jade": "~1.11.0",
    "mariadb": "^3.3.1",
    "mongoose": "^8.5.3",
    "morgan": "~1.9.1",
    "mysql2": "^3.10.1",
    "nodemon": "^3.1.4",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7",
    "tedious": "^18.2.0"
  },
  "devDependencies": {
    "migrate-mongo": "^11.0.0",
    "prettier": "^3.3.2"
  }
}
